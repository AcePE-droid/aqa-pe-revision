# Copy this file to .env.local and fill in the values. .env.local is gitignored
# and must never be committed. Full instructions: docs/environment-variables.md
#
# After changing any of these in Vercel (Settings -> Environment Variables),
# redeploy - env changes do not apply to deployments that already exist.

# --- Supabase: required for the site to run at all -------------------------
# Supabase -> Project Settings -> Data API -> Project URL. Bare origin only,
# no trailing slash and no /rest/v1 path. Safe to expose.
# In Vercel: Type Config (not Secret), Production and Preview.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> anon / publishable.
# Safe to expose; Row Level Security is what protects the data.
# In Vercel: Type Config (not Secret), Production and Preview.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase admin: required for account deletion + the leaderboard cron ---
# Supabase -> Project Settings -> API Keys -> service_role (or secret).
# SECRET. Bypasses Row Level Security. Never NEXT_PUBLIC_, never committed,
# never sent to the browser. See docs/service-role-key-setup.md.
SUPABASE_SERVICE_ROLE_KEY=

# --- Feedback form (/feedback) ---------------------------------------------
# resend.com -> API Keys -> Create API Key ("Sending access" is enough).
# Starts with re_. SECRET.
RESEND_API_KEY=

# The inbox feedback emails are delivered to. Plain address only, no display
# name. Any inbox works - the form sends from feedback@mail.acepe.co.uk,
# which is a verified sending domain. See docs/environment-variables.md.
FEEDBACK_TO_EMAIL=

# --- Leaderboard cron (Vercel only) ----------------------------------------
# Generate your own: openssl rand -hex 32
# Set this in Vercel, not here - Vercel automatically sends it as a Bearer
# token on cron invocations. Only needed locally if you want to curl the
# route by hand. SECRET.
CRON_SECRET=
